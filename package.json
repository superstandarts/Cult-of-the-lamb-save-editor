    "build:bundle": "node scripts/build-exe.js --bundle-only"
  },
  "dependencies": {
    "@addmaple/lz4": "^0.2.0",
    "express": "^5.2.1",
    "lamb-mp-decoder": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2"
  }
}
