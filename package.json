{
  "name": "cotl-save-editor-by-rage",
  "version": "1.0.0",
  "private": true,
  "description": "Localhost save editor for Cult of the Lamb",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check public/app.js && node --check scripts/build-exe.js",
